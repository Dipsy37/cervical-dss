# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cervical_dss

# Any long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Key that encrypts client names, phone numbers, villages and dates of birth. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change or lose it once clients are registered: their details could no longer be read.
ENCRYPTION_KEY=replace-with-the-generated-key

# Optional
TOKEN_EXPIRE_MINUTES=480
TEMP_PASSWORD_HOURS=72
